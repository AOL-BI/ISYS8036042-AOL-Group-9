# ===== Secrets =====
.env
*.key
credentials*.json
token*.json

# ===== Data =====
# Data mentah & hasil olahan tidak di-commit (simpan di Google Drive tim).
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Arsip data di root (mis. data.zip buat dibagi lewat Drive)
/*.zip
# data/external: arsip & file geometri besar tidak di-commit (download ulang, lihat data/external/README.md)
data/external/**/*.zip
data/external/**/*.geojson
data/external/**/*.topojson
data/external/**/*.shp
data/external/**/*.shx
data/external/**/*.dbf
data/external/**/*.prj
# Pengecualian: batas wilayah DKI hasil filter (kecil, dipakai semua anggota)
!data/external/batas-wilayah/jakarta_adm*.geojson

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# ===== Jupyter =====
.ipynb_checkpoints/

# ===== KNIME =====
# Root repo dipakai sebagai KNIME workspace: metadata workspace tidak di-commit.
.metadata/
knime-workspace/
*.knime-tmp
.knimeLock
# Workflow di knime/ di-commit TANPA data hasil eksekusi (isinya tweet & bisa besar).
# Yang ikut: workflow.knime, settings.xml tiap node, workflow.svg, metadata.
knime/**/.savedWithData
knime/**/.artifacts/
knime/**/port_*/
knime/**/internal/
knime/**/filestore/
knime/*/data/

# ===== OS / Editor =====
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ===== Office temp files =====
~$*
